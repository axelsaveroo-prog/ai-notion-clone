generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ScheduleEvent {
  id        String   @id @default(cuid())
  title     String
  client    String
  date      String
  time      String
  assignees String[]
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  channelId String
  sender    String
  text      String?
  fileUrl   String?
  fileType  String?
  createdAt DateTime @default(now())
}

model Attendance {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  userEmail String
  type      String   // "CLOCK_IN" atau "CLOCK_OUT"
  timestamp DateTime @default(now())
  imageUrl  String?  // URL foto presensi dari Supabase Storage / Base64
  location  String?  // Misal: "Office" / "Remote"
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
}

model CalendarEvent {
  id        String   @id @default(cuid())
  title     String
  client    String
  date      String
  time      String
  assignees String[]
  createdAt DateTime @default(now())
}