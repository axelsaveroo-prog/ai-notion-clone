generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ScheduleEvent {
  id        String   @id @default(cuid())
  title     String
  client    String
  date      String
  time      String
  assignees String[]
  createdAt DateTime @default(now())
}

model ChatMessage {
  id            String   @id @default(cuid())
  channelId     String
  sender        String
  senderId      String?
  senderImage   String?
  text          String?
  fileUrl       String?
  fileType      String?
  isEdited      Boolean? @default(false)
  isForwarded   Boolean? @default(false)
  replyToSender String?
  replyToText   String?
  createdAt     DateTime @default(now())

  @@index([channelId])
  @@index([createdAt])
}

model ChatChannel {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("group") // "group" | "direct"
  description String?
  members     String[] // User IDs or names
  admins      String[] @default([]) // Admin user IDs
  createdById String?
  createdAt   DateTime @default(now())
}


model Attendance {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  userEmail String
  type      String   // "CLOCK_IN" atau "CLOCK_OUT"
  timestamp DateTime @default(now())
  imageUrl  String?  // URL foto presensi dari Supabase Storage / Base64
  location  String?  // Misal: "Office" / "Remote"
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  client      String
  date        String
  time        String
  assignees   String[]
  eventType   String?  @default("online")
  meetLink    String?
  location    String?
  creatorName String?
  approvals   Json?    // Menyimpan status persetujuan assignee: { [userName]: "pending" | "accepted" | "rejected" }
  createdAt   DateTime @default(now())
}

model Task {
  id          String   @id @default(cuid())
  title       String
  client      String   @default("General")
  type        String?  @default("Feeds")
  status      String   @default("todo") // "todo" | "in_progress" | "done"
  assignee    String?  @default("You")
  assignedBy  String?
  dueDate     String?
  brief       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MomNote {
  id        String   @id @default(cuid())
  eventId   String   @unique
  title     String?
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("slate")
  createdAt DateTime @default(now())
}

model User {
  id               String            @id
  email            String            @unique
  name             String
  imageUrl         String?
  lastActiveAt     DateTime?         @default(now())
  createdAt        DateTime          @default(now())
  usersToDocuments UsersToDocument[]
}

model Document {
  id               String            @id @default(uuid())
  title            String            @default("New Doc")
  createdAt        DateTime          @default(now())
  usersToDocuments UsersToDocument[]
}

model UsersToDocument {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  role       String   @default("editor")
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
}