generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ScheduleEvent {
  id        String   @id @default(cuid())
  title     String
  client    String
  date      String
  time      String
  assignees String[]
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  channelId String
  sender    String
  text      String?
  fileUrl   String?
  fileType  String?
  createdAt DateTime @default(now())
}
